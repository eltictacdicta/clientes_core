{#
/**
 * Shared client form — discount block.
 *
 * Owns the mandatory discount-group selector and the D1-D4 discount columns.
 * Parameterized by `id_prefix` so the partial is safe to include more than
 * once per page (R7). The discount group is mandatory: there is no selectable
 * empty option, the select carries `required`, and `cliente::test()` is the
 * authoritative server-side gate.
 *
 * Context (all optional):
 *   cliente            entity to render (default null -> empty)
 *   grupos_descuentos  discount-group catalog (default [])
 *   id_prefix          DOM id prefix, unique per include (default 'cliente')
 *   input_class        input density variant (default 'form-control')
 */
#}
{% set cliente = cliente|default(null) %}
{% set grupos_descuentos = grupos_descuentos|default([]) %}
{% set id_prefix = id_prefix|default('cliente') %}
{% set input_class = input_class|default('form-control') %}

<div class="panel panel-info" style="margin-top: 15px;">
    <div class="panel-heading">
        <h4 class="panel-title">
            <i class="fa fa-percent"></i> {{ trans('descuentos') }}
            {% if cliente and cliente.codgrupo_descuento %}
                {% for gd in grupos_descuentos %}
                    {% if gd.codgrupo_descuento == cliente.codgrupo_descuento %}
                        — {{ gd.nombre }}
                        {% if cliente.descuentos_modified %}
                            <span class="label label-warning">{{ trans('modificado') }}</span>
                        {% endif %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        </h4>
    </div>
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-3">
                <div class="form-group">
                    <label for="{{ id_prefix }}_grupo_descuento">{{ trans('grupo-descuentos') }} *</label>
                    <select name="codgrupo_descuento" id="{{ id_prefix }}_grupo_descuento"
                        class="{{ input_class }}" x-model="codgrupoDescuento" required>
                        <option value="" disabled{% if not cliente or not cliente.codgrupo_descuento %} selected{% endif %}>— {{ trans('seleccione-grupo-descuentos') }} —</option>
                        {% for gd in grupos_descuentos %}
                        <option value="{{ gd.codgrupo_descuento }}"{% if cliente and cliente.codgrupo_descuento == gd.codgrupo_descuento %} selected{% endif %}>
                            {{ gd.nombre }}
                        </option>
                        {% endfor %}
                    </select>
                    <p class="help-block text-danger" id="{{ id_prefix }}_grupo_descuento_required"
                        x-show="missing()" x-cloak>
                        {{ trans('grupo-descuentos-obligatorio') }}
                    </p>
                </div>
            </div>
            {% for field in ['d1', 'd2', 'd3', 'd4'] %}
            {% set field_value = cliente ? attribute(cliente, field) : null %}
            <div class="col-sm-2">
                <div class="form-group">
                    <label>D{{ loop.index }} (%)</label>
                    <input type="number" name="{{ field }}" value="{{ field_value ?? 0 }}"
                        class="{{ input_class }}" step="0.01" min="0" max="100" />
                </div>
            </div>
            {% endfor %}
            <div class="col-sm-1">
                {% if cliente and cliente.descuentos_modified and cliente.codgrupo_descuento %}
                <div style="margin-top: 25px;">
                    <button type="button" id="{{ id_prefix }}_btn_reset_descuentos" class="btn btn-sm btn-warning">
                        <i class="fa fa-undo"></i>
                    </button>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
